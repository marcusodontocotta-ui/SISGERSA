# Banco de Dados (local = MySQL, nuvem = PostgreSQL)
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha
DB_NAME=medical_db

# Pool de conexoes: maximo de conexoes por processo (worker). Em producao
# com 4 gunicorn workers, mantenha baixo para nao estourar o limite do banco
# (ex.: 5 por worker). Padrao: 5
DB_MAX_CONNECTIONS=5

# Na nuvem, o Render.com fornece DATABASE_URL automaticamente
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Seguranca
# SECRET_KEY deve ter pelo menos 32 caracteres em producao (o app falha no startup se for fraca).
# Gere com:  py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=mude-esta-chave-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Ambiente
ENVIRONMENT=development
DEBUG=true

# Email SMTP (Gmail)
# Para Gmail: gere uma Senha de App em https://myaccount.google.com/apppasswords
EMAIL_HABILITADO=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
SMTP_FROM_NAME=SISGERSA
SMTP_FROM_EMAIL=onboarding@resend.dev
RESEND_API_KEY=re_xxxxx
